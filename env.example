# ---------------------------------------------------------------------------
# MarkaLab BI · variables de entorno
#
# Copia este archivo como .env.local para desarrollo, y carga las mismas
# variables en Vercel (Project Settings -> Environment Variables).
#
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_, a propósito: así
# viven solo en el servidor y nunca viajan al navegador del cliente.
#
# La plataforma funciona completa sin ninguna de ellas: sin modelo conectado,
# Argos calcula las respuestas sobre el corte con su motor de consulta.
# ---------------------------------------------------------------------------

# --- Argos: el modelo, por el camino corto ---------------------------------
# Con UNA de estas llaves Argos tiene modelo. La ruta /api/copiloto llama a la
# API del proveedor directamente: no hace falta n8n, ni Supabase, ni un
# workflow activo. Es el camino recomendado para la demostración.
#
# Las tres son secretas: en Vercel van como Secret y nunca al repositorio.
#
#   DeepSeek    https://platform.deepseek.com  -> API keys
#   OpenAI      https://platform.openai.com    -> API keys
#   Anthropic   https://console.anthropic.com  -> API keys
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Solo si hay más de una llave puesta: cuál manda. deepseek, openai o anthropic.
COPILOTO_PROVEEDOR=

# El modelo que contesta. Vacío usa el de omisión de cada proveedor:
#   deepseek-flash · gpt-6.2-sol · claude-sonnet-5-5
# Los nombres caducan: deepseek-chat se retiró el 24 de julio de 2026 y
# claude-sonnet-4-5 se retira el 30 de noviembre de 2026.
COPILOTO_MODELO=

# --- Argos: por n8n (opcional) ---------------------------------------------
# Solo hace falta si se quiere que el workflow guarde memoria y bitácora en
# Supabase. Si hay una llave de modelo puesta arriba, se usa primero el camino directo
# y n8n queda de respaldo.
#
# Production URL del nodo "[ML-BI] Webhook - Copiloto". Termina en
# /webhook/ml-bi/copiloto
N8N_WEBHOOK_URL=

# Production URL del nodo "[ML-BI] Webhook - Aprender". Si se deja vacía, se
# deriva sola de la anterior cambiando /copiloto por /aprender.
N8N_APRENDER_URL=

# Token opcional. Si se define, las dos llamadas lo mandan como:
#   Authorization: Bearer <token>
N8N_WEBHOOK_TOKEN=

# --- Tiempos ---------------------------------------------------------------
# Milisegundos que se le dan al modelo. Si no contesta a tiempo, Argos
# entrega el cálculo directo sobre el corte y deja de intentar el modelo
# durante tres minutos, para que nadie espere pregunta tras pregunta.
COPILOTO_TIMEOUT_MS=20000
N8N_TIMEOUT_MS=25000

# El aprendizaje tiene menos presupuesto: nadie está esperando esa respuesta.
APRENDER_TIMEOUT_MS=2500

# --- Multicliente ----------------------------------------------------------
# Separa la memoria del copiloto por marca en Supabase. 0 es la demostración.
# Para un cliente real, el id que le corresponda en markalab.clientes.
BI_CLIENTE_ID=0
